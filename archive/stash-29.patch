+/// Regression test for #58: file_size_bytes = i64::MIN should also be caught
+#[tokio::test]
+async fn test_file_size_bytes_negative_i64_min() -> DataFusionResult<()> {
+    let temp_dir =
+        TempDir::new().map_err(|e| datafusion::error::DataFusionError::External(Box::new(e)))?;
+    let catalog_path = temp_dir.path().join("filesize_min.ducklake");
+
+    common::create_catalog_no_deletes(&catalog_path).map_err(common::to_datafusion_error)?;
+
+    // Set file_size_bytes to i64::MIN (most extreme negative value)
+    {
+        let conn = duckdb::Connection::open(&catalog_path)
+            .map_err(|e| datafusion::error::DataFusionError::External(Box::new(e)))?;
+        conn.execute(
+            &format!(
+                "UPDATE ducklake_data_file SET file_size_bytes = {};",
+                i64::MIN
+            ),
+            [],
+        )
+        .map_err(|e| datafusion::error::DataFusionError::External(Box::new(e)))?;
     }
 
+    let catalog = create_catalog(&catalog_path.to_string_lossy())?;
+    let ctx = SessionContext::new();
+    ctx.register_catalog("test", catalog);
+
+    let result = ctx
+        .sql("SELECT * FROM test.main.users")
+        .await?
+        .collect()
+        .await;
+
+    let err = result.expect_err("i64::MIN file_size_bytes should produce an error");
+    let err_msg = err.to_string();
+    assert!(
+        err_msg.contains("Invalid file_size_bytes") && err_msg.contains("file size cannot be negative"),
+        "Error should clearly indicate invalid file size, got: {}",
+        err_msg
+    );
+
     Ok(())
 }
 
