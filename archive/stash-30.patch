+    /// Original scan logic without virtual columns (optimized path: groups files)
+    async fn scan_without_virtual_columns(
+        &self,
+        state: &dyn Session,
+        projection: Option<&Vec<usize>>,
+        limit: Option<usize>,
+    ) -> DataFusionResult<Arc<dyn ExecutionPlan>> {
+        let (files_with_deletes, files_without_deletes): (Vec<_>, Vec<_>) = self
+            .table_files
+            .iter()
+            .partition(|tf| tf.delete_file.is_some());
+
+        let mut execs: Vec<Arc<dyn ExecutionPlan>> = Vec::new();
+
+        if !files_without_deletes.is_empty() {
+            let exec = self
+                .build_exec_for_files_without_deletes(
+                    state,
+                    &files_without_deletes,
+                    projection,
+                    limit,
+                )
+                .await?;
+            execs.push(exec);
+        }
+
+        for table_file in files_with_deletes {
+            let exec = self
+                .build_exec_for_file_with_deletes(state, table_file, projection, limit)
+                .await?;
+            execs.push(exec);
+        }
+
+        if execs.is_empty() {
+            use datafusion::physical_plan::empty::EmptyExec;
+            let projected_schema = match projection {
+                Some(indices) => Arc::new(self.schema.project(indices)?),
+                None => self.schema.clone(),
+            };
+            return Ok(Arc::new(EmptyExec::new(projected_schema)));
+        }
+
+        combine_execution_plans(execs)
+    }
+
+    /// Scan with virtual columns — each file gets its own exec wrapped with VirtualColumnExec
+    async fn scan_with_virtual_columns(
+        &self,
+        state: &dyn Session,
+        projection: Option<&Vec<usize>>,
+        limit: Option<usize>,
+        include_filename: bool,
+        include_row_number: bool,
+        filename_idx: usize,
+        row_number_idx: usize,
+    ) -> DataFusionResult<Arc<dyn ExecutionPlan>> {
+        // Build the "real" projection (indices into base schema only)
+        let real_projection: Option<Vec<usize>> = projection.map(|indices| {
+            indices
+                .iter()
+                .filter(|&&idx| idx < self.schema.fields().len())
+                .copied()
+                .collect()
+        });
+
+        // Build the output schema of VirtualColumnExec (real projected columns + virtual columns)
+        let real_output_schema = match &real_projection {
+            Some(indices) if !indices.is_empty() => Arc::new(self.schema.project(indices)?),
+            Some(_) => {
+                // Empty real projection but virtual columns requested
+                Arc::new(Schema::empty())
+            },
+            None => self.schema.clone(),
+        };
+
+        let mut vc_fields = real_output_schema.fields().to_vec();
+        if include_filename {
+            vc_fields.push(Arc::new(Field::new(
+                VIRTUAL_COL_FILENAME,
+                DataType::Utf8,
+                true,
+            )));
+        }
+        if include_row_number {
+            vc_fields.push(Arc::new(Field::new(
+                VIRTUAL_COL_FILE_ROW_NUMBER,
+                DataType::Int64,
+                true,
+            )));
+        }
+        let vc_output_schema = Arc::new(Schema::new(vc_fields));
+
+        let real_proj_ref = real_projection.as_ref();
+
+        let mut execs: Vec<Arc<dyn ExecutionPlan>> = Vec::new();
+
+        for table_file in &self.table_files {
+            let resolved_path = self.resolve_file_path(&table_file.file);
+
+            // Build the per-file exec (with or without delete filtering)
+            let file_exec = if table_file.delete_file.is_some() {
+                self.build_exec_for_file_with_deletes(state, table_file, real_proj_ref, limit)
+                    .await?
+            } else {
+                self.build_exec_for_single_file(state, table_file, real_proj_ref, limit)
+                    .await?
+            };
+
+            // Wrap with VirtualColumnExec
+            let wrapped = Arc::new(VirtualColumnExec::new(
+                file_exec,
+                resolved_path,
+                include_filename,
+                include_row_number,
+                Arc::clone(&vc_output_schema),
+            ));
+
+            execs.push(wrapped);
+        }
+
+        if execs.is_empty() {
+            use datafusion::physical_plan::empty::EmptyExec;
+            let projected_schema = match projection {
+                Some(indices) => Arc::new(self.full_schema.project(indices)?),
+                None => self.full_schema.clone(),
+            };
+            return Ok(Arc::new(EmptyExec::new(projected_schema)));
+        }
+
+        let combined = combine_execution_plans(execs)?;
+
+        // Check if we need to reorder columns because the projection interleaves
+        // real and virtual columns. VirtualColumnExec always appends virtual cols
+        // at the end, but the user may have requested them in a different order.
+        if let Some(indices) = projection {
+            let needs_reorder = self.needs_reorder_projection(
+                indices,
+                include_filename,
+                include_row_number,
+                filename_idx,
+                row_number_idx,
+            );
+            if needs_reorder {
+                // Build a reorder projection
+                let reorder = self.build_reorder_projection(
+                    indices,
+                    &vc_output_schema,
+                    include_filename,
+                    include_row_number,
+                    filename_idx,
+                    row_number_idx,
+                )?;
+                use datafusion::physical_expr::expressions::Column;
+                use datafusion::physical_plan::projection::ProjectionExec;
+                let proj_exprs: Vec<(Arc<dyn datafusion::physical_expr::PhysicalExpr>, String)> =
+                    reorder
+                        .iter()
+                        .map(|&(vc_idx, ref name)| {
+                            (
+                                Arc::new(Column::new(name, vc_idx))
+                                    as Arc<dyn datafusion::physical_expr::PhysicalExpr>,
+                                name.clone(),
+                            )
+                        })
+                        .collect();
+                return Ok(Arc::new(ProjectionExec::try_new(proj_exprs, combined)?));
+            }
+        }
+
+        Ok(combined)
+    }
+
+    /// Check if the projection requires reordering (virtual columns not at end)
+    fn needs_reorder_projection(
+        &self,
+        indices: &[usize],
+        include_filename: bool,
+        include_row_number: bool,
+        filename_idx: usize,
+        row_number_idx: usize,
+    ) -> bool {
+        // The VirtualColumnExec output has: [real_cols..., filename?, row_number?]
+        // We need to reorder if the projection doesn't match this order.
+        let base_count = self.schema.fields().len();
+
+        // Build expected output order: real indices first, then virtual
+        let mut expected: Vec<usize> = Vec::new();
+        for &idx in indices {
+            if idx < base_count {
+                expected.push(idx);
+            }
+        }
+        if include_filename {
+            expected.push(filename_idx);
+        }
+        if include_row_number {
+            expected.push(row_number_idx);
+        }
+
+        // If the projection matches expected order, no reorder needed
+        indices != expected.as_slice()
+    }
+
+    /// Build reorder mapping: for each position in the desired output,
+    /// return (index_in_vc_output, column_name)
+    fn build_reorder_projection(
+        &self,
+        indices: &[usize],
+        vc_output_schema: &SchemaRef,
+        include_filename: bool,
+        include_row_number: bool,
+        filename_idx: usize,
+        row_number_idx: usize,
+    ) -> DataFusionResult<Vec<(usize, String)>> {
+        let base_count = self.schema.fields().len();
+
+        // Build a mapping from original index -> position in vc_output_schema
+        // vc_output_schema is: [real_projected_cols..., filename?, row_number?]
+        let mut real_col_position = 0;
+        let mut original_to_vc: HashMap<usize, usize> = HashMap::new();
+        for &idx in indices {
+            if idx < base_count {
+                original_to_vc.insert(idx, real_col_position);
+                real_col_position += 1;
+            }
+        }
+
+        // Virtual columns are appended after real columns
+        let mut vc_pos = real_col_position;
+        if include_filename {
+            original_to_vc.insert(filename_idx, vc_pos);
+            vc_pos += 1;
+        }
+        if include_row_number {
+            original_to_vc.insert(row_number_idx, vc_pos);
+        }
+
+        // Now build the reorder: for each index in the desired projection,
+        // find its position in the vc_output_schema
+        let mut result = Vec::with_capacity(indices.len());
+        for &idx in indices {
+            let vc_idx = original_to_vc.get(&idx).ok_or_else(|| {
+                DataFusionError::Internal(format!(
+                    "Virtual column projection index {} not found in mapping",
+                    idx
+                ))
+            })?;
+            let name = vc_output_schema.field(*vc_idx).name().clone();
+            result.push((*vc_idx, name));
+        }
+
+        Ok(result)
+    }
+
+    /// Build an execution plan for a single file (no delete filtering)
+    ///
+    /// Used when virtual columns are requested, since files must be scanned
+    /// individually to provide per-file filename values.
+    async fn build_exec_for_single_file(
+        &self,
+        state: &dyn Session,
+        table_file: &DuckLakeTableFile,
+        projection: Option<&Vec<usize>>,
+        limit: Option<usize>,
+    ) -> DataFusionResult<Arc<dyn ExecutionPlan>> {
+        let (read_schema, name_mapping) = self.get_schema_mapping(state).await?;
+
+        let resolved_path = self.resolve_file_path(&table_file.file);
+
+        let mut pf = PartitionedFile::new(&resolved_path, table_file.file.file_size_bytes as u64);
+        if let Some(footer_size) = table_file.file.footer_size {
+            pf = pf.with_metadata_size_hint(footer_size as usize);
+        }
+
+        let mut builder = FileScanConfigBuilder::new(
+            self.object_store_url.as_ref().clone(),
+            read_schema.clone(),
+            Arc::new(self.create_parquet_source()),
+        )
+        .with_limit(limit)
+        .with_file_group(FileGroup::new(vec![pf]));
+
+        if let Some(proj) = projection {
+            builder = builder.with_projection_indices(Some(proj.clone()));
+        }
+
+        let file_scan_config = builder.build();
+        let parquet_exec: Arc<dyn ExecutionPlan> =
+            DataSourceExec::from_data_source(file_scan_config);
+
+        if !name_mapping.is_empty() {
+            let output_schema = match projection {
+                Some(indices) => Arc::new(self.schema.project(indices)?),
+                None => self.schema.clone(),
+            };
+            Ok(Arc::new(ColumnRenameExec::new(
+                parquet_exec,
+                output_schema,
+                name_mapping.clone(),
+            )))
+        } else {
+            Ok(parquet_exec)
+        }
+    }
