+// ==================== R6-S-032: DF DROP TABLE → DuckDB behavior ====================
+
+#[tokio::test(flavor = "multi_thread")]
+async fn cross_engine_df_drop_table_duckdb_behavior() {
+    let env = setup_ducklake_catalog().await;
+    let object_store: Arc<dyn object_store::ObjectStore> = Arc::new(LocalFileSystem::new());
+
+    // Write two tables
+    let conn_str = format!("sqlite:{}?mode=rwc", env.catalog_db_path.display());
+    let writer = SqliteMetadataWriter::new(&conn_str)
+        .await
+        .expect("create writer");
+
+    let schema = Arc::new(Schema::new(vec![
+        Field::new("id", DataType::Int32, false),
+        Field::new("val", DataType::Utf8, true),
+    ]));
+
+    let batch1 = RecordBatch::try_new(
+        schema.clone(),
+        vec![
+            Arc::new(Int32Array::from(vec![1, 2])),
+            Arc::new(StringArray::from(vec![Some("keep_a"), Some("keep_b")])),
+        ],
+    )
+    .unwrap();
+
+    let batch2 = RecordBatch::try_new(
+        schema,
+        vec![
+            Arc::new(Int32Array::from(vec![10])),
+            Arc::new(StringArray::from(vec![Some("drop_me")])),
+        ],
+    )
+    .unwrap();
+
+    let table_writer =
+        DuckLakeTableWriter::new(Arc::new(writer), object_store).unwrap();
+    table_writer
+        .write_table("main", "keep_table", &[batch1])
+        .await
+        .unwrap();
+    table_writer
+        .write_table("main", "drop_table", &[batch2])
+        .await
+        .unwrap();
+
+    // Verify DuckDB sees both tables
+    let duckdb = DuckDbConn::open(&env.catalog_db_path);
+    let rows = duckdb.query("SELECT COUNT(*) FROM ducklake.main.keep_table");
+    assert_eq!(rows[0][0], "2");
+    let rows = duckdb.query("SELECT COUNT(*) FROM ducklake.main.drop_table");
+    assert_eq!(rows[0][0], "1");
+    drop(duckdb);
+
+    // DataFusion drops one table
+    let ctx = open_in_datafusion_writable_dml(&env.catalog_db_path).await;
+    ctx.sql("DROP TABLE ducklake.main.drop_table")
+        .await
+        .unwrap()
+        .collect()
+        .await
+        .unwrap();
+
+    // DuckDB verifies: dropped table is gone, other table is intact
+    let duckdb2 = DuckDbConn::open(&env.catalog_db_path);
+    let result = duckdb2.try_query("SELECT * FROM ducklake.main.drop_table");
+    assert!(
+        result.is_err(),
+        "DuckDB should not find the dropped table"
+    );
+
+    let rows = duckdb2.query("SELECT id, val FROM ducklake.main.keep_table ORDER BY id");
+    assert_eq!(rows.len(), 2);
+    assert_eq!(rows[0], vec!["1", "keep_a"]);
+    assert_eq!(rows[1], vec!["2", "keep_b"]);
+}
