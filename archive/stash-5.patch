+// ==================== R6-S-049: BOOLEAN type roundtrip ====================
+
+#[tokio::test(flavor = "multi_thread")]
+async fn cross_engine_boolean_type_roundtrip() {
+    // Direction 1: DuckDB writes BOOLEAN → DataFusion reads
+    let temp_dir = TempDir::new().unwrap();
+    let catalog_path = temp_dir.path().join("booleans.ducklake");
+    let data_path = temp_dir.path().join("data");
+    std::fs::create_dir_all(&data_path).unwrap();
+
+    let duckdb = DuckDbConn::open_with_data_path(&catalog_path, &data_path);
+    duckdb.execute(
+        "CREATE TABLE ducklake.main.flags (id INT, is_active BOOLEAN, is_admin BOOLEAN)",
+    );
+    duckdb.execute(
+        "INSERT INTO ducklake.main.flags VALUES \
+         (1, true, false), \
+         (2, false, true), \
+         (3, true, true), \
+         (4, NULL, false)",
+    );
+
+    let duckdb_rows =
+        duckdb.query("SELECT id, is_active, is_admin FROM ducklake.main.flags ORDER BY id");
+    drop(duckdb);
+
+    // DataFusion reads DuckDB-written BOOLEAN values
+    let ctx = open_in_datafusion_duckdb(&catalog_path);
+    let df_rows = df_query(
+        &ctx,
+        "SELECT id, is_active, is_admin FROM ducklake.main.flags ORDER BY id",
+    )
+    .await;
+
+    assert_eq!(df_rows.len(), 4);
+    assert_results_eq("boolean_duckdb_to_df", &duckdb_rows, &df_rows);
+
+    // Verify specific boolean values
+    assert_eq!(df_rows[0][1], "true");
+    assert_eq!(df_rows[0][2], "false");
+    assert_eq!(df_rows[1][1], "false");
+    assert_eq!(df_rows[1][2], "true");
+    assert_eq!(df_rows[2][1], "true");
+    assert_eq!(df_rows[2][2], "true");
+    assert_eq!(df_rows[3][1], "NULL");
+    assert_eq!(df_rows[3][2], "false");
+
+    // Direction 2: DataFusion writes BOOLEAN → DuckDB reads
+    let env = setup_ducklake_catalog().await;
+    let object_store: Arc<dyn object_store::ObjectStore> = Arc::new(LocalFileSystem::new());
+
+    let conn_str = format!("sqlite:{}?mode=rwc", env.catalog_db_path.display());
+    let writer = SqliteMetadataWriter::new(&conn_str)
+        .await
+        .expect("create writer");
+
+    let bool_schema = Arc::new(Schema::new(vec![
+        Field::new("id", DataType::Int32, false),
+        Field::new("flag_a", DataType::Boolean, true),
+        Field::new("flag_b", DataType::Boolean, true),
+    ]));
+
+    let bool_batch = RecordBatch::try_new(
+        bool_schema,
+        vec![
+            Arc::new(Int32Array::from(vec![1, 2, 3])),
+            Arc::new(BooleanArray::from(vec![Some(true), Some(false), None])),
+            Arc::new(BooleanArray::from(vec![Some(false), Some(true), Some(true)])),
+        ],
+    )
+    .unwrap();
+
+    let table_writer = DuckLakeTableWriter::new(Arc::new(writer), object_store).unwrap();
+    table_writer
+        .write_table("main", "bool_test", &[bool_batch])
+        .await
+        .unwrap();
+
+    // DuckDB reads DF-written boolean data
+    let duckdb2 = DuckDbConn::open(&env.catalog_db_path);
+    let rows = duckdb2.query("SELECT id, flag_a, flag_b FROM ducklake.main.bool_test ORDER BY id");
+    assert_eq!(rows.len(), 3);
+    assert_eq!(rows[0][0], "1");
+    assert_eq!(rows[0][1], "true");
+    assert_eq!(rows[0][2], "false");
+    assert_eq!(rows[1][0], "2");
+    assert_eq!(rows[1][1], "false");
+    assert_eq!(rows[1][2], "true");
+    assert_eq!(rows[2][0], "3");
+    assert_eq!(rows[2][1], "NULL");
+    assert_eq!(rows[2][2], "true");
+
+    // Also verify DF can read its own boolean data back
+    let ctx2 = open_in_datafusion_sqlite(&env.catalog_db_path).await;
+    let df_rows2 = df_query(
+        &ctx2,
+        "SELECT id, flag_a, flag_b FROM ducklake.main.bool_test ORDER BY id",
+    )
+    .await;
+    assert_eq!(df_rows2.len(), 3);
+    assert_eq!(df_rows2[0][1], "true");
+    assert_eq!(df_rows2[1][1], "false");
+    assert_eq!(df_rows2[2][1], "NULL");
+}
