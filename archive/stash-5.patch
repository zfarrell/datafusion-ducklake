+/// Normalized partition transform, resolved from string at planning time.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum PartitionTransform {
+    Identity,
+    Year,
+    Month,
+    Day,
+    Hour,
+}
+
+impl PartitionTransform {
+    /// Parse a transform string (case-insensitive) into an enum variant.
+    pub fn from_str_opt(s: Option<&str>) -> std::result::Result<Self, String> {
+        match s.map(|t| t.to_lowercase()).as_deref() {
+            None | Some("identity") | Some("") => Ok(PartitionTransform::Identity),
+            Some("year") => Ok(PartitionTransform::Year),
+            Some("month") => Ok(PartitionTransform::Month),
+            Some("day") => Ok(PartitionTransform::Day),
+            Some("hour") => Ok(PartitionTransform::Hour),
+            Some(other) => Err(format!(
+                "Unknown partition transform '{}'. Valid transforms: identity, year, month, day, hour",
+                other
+            )),
+        }
+    }
+}
