+// ==================== R6-S-048: Schema assertions (column names + types) ====================
+
+/// Helper: Query DuckDB for column names and types of a table.
+fn duckdb_table_schema(duckdb: &DuckDbConn, table_name: &str) -> Vec<(String, String)> {
+    let rows = duckdb.query(&format!(
+        "SELECT column_name, data_type FROM information_schema.columns \
+         WHERE table_name = '{}' AND table_schema = 'main' ORDER BY ordinal_position",
+        table_name
+    ));
+    rows.into_iter()
+        .map(|r| (r[0].clone(), r[1].clone()))
+        .collect()
+}
+
+/// Helper: Query DataFusion for column names and types of a table.
+async fn df_table_schema(
+    ctx: &SessionContext,
+    full_table_ref: &str,
+) -> Vec<(String, String)> {
+    let df = ctx.sql(&format!("SELECT * FROM {} LIMIT 0", full_table_ref))
+        .await
+        .unwrap();
+    let schema = df.schema();
+    schema
+        .fields()
+        .iter()
+        .filter(|f| {
+            !["filename", "file_row_number", "rowid", "snapshot_id", "file_index"]
+                .contains(&f.name().as_str())
+        })
+        .map(|f| {
+            let type_name = format!("{:?}", f.data_type());
+            (f.name().clone(), type_name)
+        })
+        .collect()
+}
+
+/// Normalize DuckDB type strings to canonical Arrow-ish names for comparison.
+fn normalize_duckdb_type(t: &str) -> &str {
+    match t {
+        "INTEGER" => "Int32",
+        "BIGINT" => "Int64",
+        "SMALLINT" => "Int16",
+        "TINYINT" => "Int8",
+        "DOUBLE" => "Float64",
+        "FLOAT" => "Float32",
+        "VARCHAR" => "Utf8",
+        "BOOLEAN" => "Boolean",
+        "DATE" => "Date32",
+        "TIMESTAMP" => "Timestamp",
+        _ => t,
+    }
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn cross_engine_schema_column_names_match() {
+    let temp_dir = TempDir::new().unwrap();
+    let catalog_path = temp_dir.path().join("schema_test.ducklake");
+    let data_path = temp_dir.path().join("data");
+    std::fs::create_dir_all(&data_path).unwrap();
+
+    // DuckDB creates table with typed columns
+    let duckdb = DuckDbConn::open_with_data_path(&catalog_path, &data_path);
+    duckdb.execute(
+        "CREATE TABLE ducklake.main.typed (id INT, name VARCHAR, score DOUBLE, active BOOLEAN)",
+    );
+    duckdb.execute(
+        "INSERT INTO ducklake.main.typed VALUES (1, 'Alice', 95.5, true), (2, 'Bob', 87.0, false)",
+    );
+
+    // Get DuckDB schema
+    let duckdb_schema = duckdb_table_schema(&duckdb, "typed");
+    drop(duckdb);
+
+    // Get DataFusion schema
+    let ctx = open_in_datafusion_duckdb(&catalog_path);
+    let df_schema = df_table_schema(&ctx, "ducklake.main.typed").await;
+
+    // Verify column names match exactly
+    let duckdb_names: Vec<&str> = duckdb_schema.iter().map(|(n, _)| n.as_str()).collect();
+    let df_names: Vec<&str> = df_schema.iter().map(|(n, _)| n.as_str()).collect();
+    assert_eq!(
+        duckdb_names, df_names,
+        "Column names should match between DuckDB and DataFusion"
+    );
+
+    // Verify column types are compatible
+    for (i, ((_, duckdb_type), (_, df_type))) in
+        duckdb_schema.iter().zip(df_schema.iter()).enumerate()
+    {
+        let normalized_duckdb = normalize_duckdb_type(duckdb_type);
+        assert!(
+            df_type.contains(normalized_duckdb)
+                || (normalized_duckdb == "Timestamp" && df_type.contains("Timestamp")),
+            "Column {} type mismatch: DuckDB='{}' (normalized='{}'), DF='{}'",
+            i,
+            duckdb_type,
+            normalized_duckdb,
+            df_type
+        );
+    }
+
+    // Also verify data values still match
+    let df_rows = df_query(
+        &ctx,
+        "SELECT id, name, score, active FROM ducklake.main.typed ORDER BY id",
+    )
+    .await;
+    assert_eq!(df_rows.len(), 2);
+    assert_eq!(df_rows[0][0], "1");
+    assert_eq!(df_rows[0][1], "Alice");
+    assert_eq!(df_rows[1][0], "2");
+    assert_eq!(df_rows[1][3], "false");
+}
