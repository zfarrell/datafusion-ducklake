+/// Convert an Arrow array value to string for the SLT adapter.
+///
+/// Delegates to `test_utils::arrow_value_to_string` for shared types,
+/// adding SLT-specific handling for floats (NaN/Inf) and Binary.
+fn slt_arrow_value_to_string(
+    column: &dyn datafusion::arrow::array::Array,
+    row_idx: usize,
+    col_idx: usize,
+) -> String {
+    use super::common::test_utils::arrow_value_to_string;
+
+    match column.data_type() {
+        // SLT adapter needs DuckDB float conventions (NaN→"nan", Inf→"inf")
+        DataType::Float32 => {
+            let arr = column.as_any().downcast_ref::<Float32Array>().unwrap();
+            format_float(arr.value(row_idx) as f64)
+        },
+        DataType::Float64 => {
+            let arr = column.as_any().downcast_ref::<Float64Array>().unwrap();
+            format_float(arr.value(row_idx))
+        },
+        // Binary is SLT-specific (not needed in cross-engine tests)
+        DataType::Binary => {
+            let arr = column.as_any().downcast_ref::<BinaryArray>().unwrap();
+            let bytes = arr.value(row_idx);
+            bytes
+                .iter()
+                .map(|b| format!("{:02X}", b))
+                .collect::<String>()
+        },
+        // All other types: delegate to shared converter
+        other => {
+            // Verify the shared converter supports this type (it panics with <unsupported:...> prefix for unknown types)
+            let result = arrow_value_to_string(column, row_idx);
+            if result.starts_with("<unsupported:") {
+                panic!(
+                    "convert_batch_to_strings: unsupported Arrow type {:?} at col {} row {}",
+                    other, col_idx, row_idx
+                );
+            }
+            result
+        },
+    }
+}
