+    /// Check if a CTE-prefixed statement wraps a DML keyword (INSERT/UPDATE/DELETE/MERGE).
+    /// Scans past balanced parentheses in the CTE definitions to find the main statement.
+    fn cte_wraps_dml(upper_sql: &str) -> bool {
+        let dml_keywords = ["INSERT ", "UPDATE ", "DELETE ", "MERGE "];
+        // Skip past CTE definitions by tracking parenthesis depth.
+        // The main statement follows the last `)` at depth 0 after `AS (...)` blocks.
+        let mut depth: i32 = 0;
+        let mut in_quote = false;
+        let bytes = upper_sql.as_bytes();
+        let len = bytes.len();
+        let mut i = 0;
+        // Track position after the last top-level closing paren
+        let mut last_close_at_zero = None;
+        while i < len {
+            let b = bytes[i];
+            if in_quote {
+                if b == b'\'' {
+                    // Check for escaped quote
+                    if i + 1 < len && bytes[i + 1] == b'\'' {
+                        i += 2;
+                        continue;
+                    }
+                    in_quote = false;
+                }
+                i += 1;
+                continue;
+            }
+            match b {
+                b'\'' => in_quote = true,
+                b'(' => depth += 1,
+                b')' => {
+                    depth -= 1;
+                    if depth == 0 {
+                        last_close_at_zero = Some(i);
+                    }
+                },
+                _ => {},
+            }
+            i += 1;
+        }
+        // The main statement starts after the last top-level closing paren
+        if let Some(pos) = last_close_at_zero {
+            let remainder = upper_sql[pos + 1..].trim_start();
+            // Allow an optional comma and another CTE before the main statement
+            // but typically the main statement directly follows
+            for kw in &dml_keywords {
+                if remainder.starts_with(kw) {
+                    return true;
+                }
+            }
+        }
+        false
+    }
