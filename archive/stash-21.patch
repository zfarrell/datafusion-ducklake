diff --git a/tests/common/mod.rs b/tests/common/mod.rs
index 342cfdc..1db2d8c 100644
--- a/tests/common/mod.rs
+++ b/tests/common/mod.rs
@@ -10,6 +10,24 @@
 
 use anyhow::Result;
 use std::path::Path;
+use std::sync::Once;
+
+static INSTALL_DUCKLAKE: Once = Once::new();
+
+/// Install the ducklake extension once (thread-safe across parallel tests)
+fn ensure_ducklake_installed() -> Result<()> {
+    let mut install_err: Option<String> = None;
+    INSTALL_DUCKLAKE.call_once(|| {
+        let conn = duckdb::Connection::open_in_memory().expect("open in-memory duckdb");
+        if let Err(e) = conn.execute("INSTALL ducklake;", []) {
+            install_err = Some(e.to_string());
+        }
+    });
+    if let Some(err) = install_err {
+        anyhow::bail!("Failed to install ducklake extension: {}", err);
+    }
+    Ok(())
+}
 
