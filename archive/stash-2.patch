+        .fetch_all(&mut **tx)
+        .await?;
+
+        if rows.is_empty() {
+            return Ok(());
+        }
+
+        struct ColumnAgg {
+            contains_null: bool,
+            min_value: Option<String>,
+            max_value: Option<String>,
+            is_numeric: bool,
+        }
+
