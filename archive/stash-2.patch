+                 ON fcs.data_file_id = df.data_file_id
+                 AND df.table_id = fcs.table_id
+                 AND df.end_snapshot IS NULL
+             INNER JOIN ducklake_column c ON fcs.column_id = c.column_id
+             WHERE fcs.table_id = ?",
+        )
