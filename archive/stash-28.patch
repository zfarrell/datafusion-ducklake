 use datafusion::datasource::object_store::ObjectStoreUrl;
 use std::sync::Arc;
 
+/// Reject paths containing null bytes (literal \0 or URL-encoded %00)
+fn validate_no_null_bytes(path: &str) -> Result<()> {
+    if path.contains('\0') {
+        return Err(DuckLakeError::InvalidConfig(format!(
+            "Path contains null byte: {}",
+            path.replace('\0', "\\0")
+        )));
+    }
+    if path.to_ascii_lowercase().contains("%00") {
+        return Err(DuckLakeError::InvalidConfig(format!(
+            "Path contains URL-encoded null byte (%00): {}",
+            path
+        )));
+    }
+    Ok(())
+}
+
+/// Reject paths containing .. traversal (literal or URL-encoded %2e%2e)
+fn validate_no_path_traversal(path: &str) -> Result<()> {
+    // Check URL-encoded variants first (case-insensitive)
+    if path.to_ascii_lowercase().contains("%2e%2e") {
+        return Err(DuckLakeError::InvalidConfig(format!(
+            "Path traversal detected: URL-encoded '..': {}",
+            path
+        )));
+    }
+    // Check literal .. as standalone path component (split on both / and \)
+    for component in path.split(|c| c == '/' || c == '\\') {
+        if component == ".." {
+            return Err(DuckLakeError::InvalidConfig(format!(
+                "Path traversal detected: path contains '..' component: {}",
+                path
+            )));
+        }
+    }
+    Ok(())
+}
+
+/// Combined path validation: reject null bytes and path traversal
+fn validate_path(path: &str) -> Result<()> {
+    validate_no_null_bytes(path)?;
+    validate_no_path_traversal(path)?;
+    Ok(())
+}
