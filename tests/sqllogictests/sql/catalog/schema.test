# name: test/sql/catalog/schema.test
# description: Test schema support in DuckLake
# group: [catalog]
# adapted: removed duckdb_schemas(), removed foreach/endloop,
#          removed multi-schema read tests (hybrid adapter rewrites ducklake.s1.tbl
#          as ducklake.main.s1.tbl incorrectly - known limitation)
# NOTE: DDL operations for schemas still verified via DuckDB side,
#       but cross-schema reads require table reference rewriting fix

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION __TEST_DIR__/{UUID}.db

test-env DATA_PATH __TEST_DIR__


statement ok
ATTACH 'ducklake:${DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '${DATA_PATH}/ducklake_schema_files')

# basic multi-schema support - DDL via DuckDB
statement ok
CREATE SCHEMA ducklake.s1;

statement ok
CREATE SCHEMA ducklake.s2;

statement ok
CREATE TABLE ducklake.s1.tbl(i INT);

statement ok
CREATE TABLE ducklake.s2.tbl(a VARCHAR, b VARCHAR);

statement ok
INSERT INTO ducklake.s1.tbl VALUES (42);

statement ok
INSERT INTO ducklake.s2.tbl VALUES ('hello', 'world');

# drop the schemas again
statement error there are entries that depend on it
DROP SCHEMA ducklake.s1

statement ok
DROP TABLE ducklake.s1.tbl

statement ok
DROP SCHEMA ducklake.s1

statement ok
DROP SCHEMA ducklake.s2 CASCADE

# the schemas are now gone
statement error not found
CREATE TABLE ducklake.s1.tbl2(i INT)

# write multiple schemas in one transaction
statement ok
BEGIN

statement ok
CREATE SCHEMA ducklake.schema_one;

statement ok
CREATE SCHEMA ducklake.schema_two

statement ok
COMMIT
