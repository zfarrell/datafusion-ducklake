# name: test/sql/catalog/drop_table.test
# description: Test dropping of tables in DuckLake
# group: [catalog]
# adapted: removed transaction-local tests (hybrid adapter reads committed state only),
#          removed duckdb_tables(), statement error format

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION __TEST_DIR__/{UUID}.db

test-env DATA_PATH __TEST_DIR__


statement ok
ATTACH 'ducklake:${DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '${DATA_PATH}/ducklake_drop_files')

statement ok
CREATE TABLE ducklake.test(i INTEGER);

query I
SELECT * FROM ducklake.test
----

statement ok
DROP TABLE ducklake.test

statement ok
DROP TABLE IF EXISTS ducklake.test

statement error does not exist
DROP TABLE ducklake.test

# create and drop with data
statement ok
CREATE TABLE ducklake.test(i INTEGER);

statement ok
INSERT INTO ducklake.test VALUES (42);

query I
SELECT * FROM ducklake.test
----
42

statement ok
DROP TABLE ducklake.test

# drop and create the same table name with different schema
statement ok
CREATE TABLE ducklake.test(i VARCHAR, j VARCHAR);

statement ok
INSERT INTO ducklake.test VALUES ('hello', 'world');

query TT
SELECT * FROM ducklake.test
----
hello	world
