# name: test/sql/delete/truncate_table.test
# description: Test ducklake truncating a table
# group: [delete]
# adapted: removed transaction wrappers, removed glob() file verification

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION __TEST_DIR__/{UUID}.db

test-env DATA_PATH __TEST_DIR__


statement ok
ATTACH 'ducklake:${DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '${DATA_PATH}/ducklake_truncate_files')

# create and truncate
statement ok
CREATE TABLE ducklake.test_local AS SELECT i id FROM range(10000) t(i);

query I
SELECT COUNT(*) FROM ducklake.test_local
----
10000

statement ok
DELETE FROM ducklake.test_local

query I
SELECT COUNT(*) FROM ducklake.test_local
----
0

# second table: create, truncate, verify
statement ok
CREATE TABLE ducklake.test AS SELECT i id FROM range(10000) t(i);

statement ok
DELETE FROM ducklake.test

query I
SELECT COUNT(*) FROM ducklake.test
----
0

# delete on already empty table
statement ok
DELETE FROM ducklake.test
