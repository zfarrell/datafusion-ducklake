# name: test/sql/insert/insert_into_self.test
# description: Test ducklake insert into self
# group: [insert]
# adapted: query I INSERT → statement ok, INSERT FROM → INSERT SELECT, STRLEN → length

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION __TEST_DIR__/{UUID}.db

test-env DATA_PATH __TEST_DIR__


statement ok
ATTACH 'ducklake:${DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '${DATA_PATH}/ducklake_insert_self_files')

statement ok
CREATE TABLE ducklake.test(i INTEGER, j VARCHAR);

statement ok
BEGIN

statement ok
INSERT INTO ducklake.test VALUES (1, '2'), (NULL, '3');

statement ok
INSERT INTO ducklake.test SELECT * FROM ducklake.test

statement ok
INSERT INTO ducklake.test SELECT * FROM ducklake.test

statement ok
INSERT INTO ducklake.test SELECT * FROM ducklake.test

statement ok
INSERT INTO ducklake.test SELECT a.i, a.j FROM ducklake.test a, ducklake.test b

statement ok
COMMIT

query III
SELECT SUM(i), SUM(length(j)), COUNT(*) FROM ducklake.test
----
136	272	272
