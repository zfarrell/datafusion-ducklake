# name: test/sql/update/basic_update.test
# description: Test ducklake updates
# group: [update]
# adapted: removed transaction wrapper (hybrid adapter reads committed state only),
#          removed time travel query

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION __TEST_DIR__/{UUID}.db

test-env DATA_PATH __TEST_DIR__


statement ok
ATTACH 'ducklake:${DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '${DATA_PATH}/ducklake_update_files');

statement ok
CREATE TABLE ducklake.test AS SELECT 1000 + i id, i % 10 as val FROM range(1000) t(i);

query III
SELECT COUNT(*), SUM(id), SUM(val) FROM ducklake.test
----
1000	1499500	4500

statement ok
UPDATE ducklake.test SET id=id+2 WHERE id%2=0

query III
SELECT COUNT(*), SUM(id), SUM(val) FROM ducklake.test
----
1000	1500500	4500
